#Exercise 2: Apply Encapsulation
class Person: 
    def __init__(self, name, age):
        self.name = name
        self.__age = age #Private attribute

    def get_age(self):
        return self.__age

person2 = Person("Lina", 20)
print(f"Name: {person2.name}")
print(f"Age: {person2.get_age()}") 

#Reflection: It is better to access the private attribute age through a getter method which is get_age() to ensure encapsulation and dat protection.

print("-------------------------")

#Exercise 3: Apply Inheritance
class Person:
    def __init__(self, name, age):
        self.name = name
        self.__age = age #Private attribute

    def get_age(self):
        return self.__age

class Student(Person):
    def __init__(self, name, age):
        super().__init__(name, age) 

    def study(self):
        return f"{self.name} is studying"

student1 = Student("Lina", 20)
print (f"Name: {student1.name}")
print (f"Age: {student1.get_age()}")
print (student1.study())

print("-------------------------")

#Exercise 4: Create the Teacher Class
class Person:
    def __init__(self, name, age):
        self.name = name
        self.__age = age #Private attribute

    def get_age(self):
        return self.__age

class Teacher(Person):
    def __init__(self, name, age):
        super().__init__(name, age)

    def teach(self):
        return f"{self.name} is teaching"

teacher1 = Teacher("Mona", 30)
print (f"Name: {teacher1.name}")
print (f"Age: {teacher1.get_age()}")
print (teacher1.teach())

print("-------------------------")